# Data is never committed. Anyone cloning the repo runs download_data.py.
data/raw/*
!data/raw/.gitkeep
!data/README.md

# Models are build artefacts: notebook 03 recreates them.
models/*
!models/.gitkeep
*.joblib
*.pkl
*.keras
*.h5

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.Python
env/
venv/
.venv/
*.egg-info/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets: this repo is a fork of a public repo, so keys never get committed.
.env

# Clean data is rebuilt from raw data by code, so it is not committed either.
data/clean/*
!data/clean/.gitkeep

# Paper PDFs are publishers' files: keep them local. The saved tables and quotes are enough to trace every number.
references/literature_raw/**/*.pdf

# Riptide artifacts (cloud-synced)
.humanlayer/tasks/
# Full paper text (XML) stays local too, like the PDFs.
references/literature_raw/**/*.xml

# Streamlit secrets stay local
.streamlit/secrets.toml

# Office temp files (exist while a deck is open)
~$*
